{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Запустить сервер (uvicorn, отладка)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--reload-exclude",
        "${workspaceFolder}/.venv",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Тесты: текущий файл",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-q"
      ],
      "justMyCode": false
    }
  ]
}